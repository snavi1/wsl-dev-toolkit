#!/usr/bin/env bash

###############################################################################
# WSL Developer Toolkit
###############################################################################

set -o errexit
set -o nounset
set -o pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

VERSION_FILE="$PROJECT_ROOT/VERSION"

usage() {

cat << EOF

WSL Developer Toolkit

Usage:

    wdt <command>

Commands

    doctor      Run complete system diagnostics
    version     Show toolkit version
    help        Show this help

Examples

    wdt doctor
    wdt version
    wdt help

EOF

}

show_version() {

    if [[ -f "$VERSION_FILE" ]]; then
        cat "$VERSION_FILE"
    else
        echo "Unknown"
    fi
}

case "${1:-help}" in

    doctor)
        exec "$PROJECT_ROOT/scripts/doctor.sh"
        ;;

    version|-v|--version)
        show_version
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        echo "Unknown command: $1"
        echo
        usage
        exit 1
        ;;

esac
