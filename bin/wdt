#!/usr/bin/env bash
#
# =============================================================================
# WSL Developer Toolkit
# Main CLI
# =============================================================================

set -o errexit
set -o nounset
set -o pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# # shellcheck disable=SC1091
source "$PROJECT_ROOT/lib/common.sh"

show_help() {
    cat <<EOF

WSL Developer Toolkit

Usage:

    wdt <command>

Commands

    doctor      Check workstation health
    lint        Lint project shell scripts
    version     Show toolkit version
    help        Show this help

EOF
}

case "${1:-help}" in

    version)
        get_version
        ;;

    help|-h|--help)
        show_help
        ;;

    doctor)
        "$PROJECT_ROOT/scripts/doctor.sh"
        ;;

    lint)
        "$PROJECT_ROOT/scripts/lint.sh"
        ;;

    *)
        die "Unknown command: $1"
        ;;
esac
